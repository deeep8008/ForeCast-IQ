# ForecastIQ Backend Configuration
PROJECT_NAME="ForecastIQ Backend"
API_V1_STR="/api"
MAX_UPLOAD_SIZE_BYTES=157286400

# MongoDB Persistence Layer Configuration
# Provide your MongoDB connection URI and database name below
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="forecastiq"
MONGODB_ENABLED="true"

# Authentication & Session Management Configuration
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_NAME="forecastiq_session"
AUTH_COOKIE_SECURE="false"
FRONTEND_ORIGIN="http://localhost:5173"

